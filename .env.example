# Database
DATABASE_URL=postgresql+asyncpg://feedstream:feedstream@localhost:5433/feedstream

# Redis
REDIS_URL=redis://localhost:6379/0

# AIS Stream
AIS_API_KEY=your_aisstream_api_key_here

# App
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_DOCS=true
ENABLE_METRICS=true
DEBUG_STATS_TOKEN=local-dev-token
RETENTION_DAYS=30
RETENTION_BATCH_SIZE=5000
RETENTION_INTERVAL_MINUTES=1440
PUBLIC_BASE_URL=http://localhost:8000
GITHUB_REPO_URL=https://github.com/Archangel-77/feedstream
