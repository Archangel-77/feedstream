# Database
DATABASE_URL=postgresql+asyncpg://user:pass@prod-db-host:5432/feedstream

# Redis
REDIS_URL=redis://prod-redis-host:6379/0

# AIS Stream
AIS_API_KEY=replace_in_secret_store

# App
APP_ENV=production
LOG_LEVEL=INFO
ENABLE_DOCS=false
ENABLE_METRICS=true
DEBUG_STATS_TOKEN=replace_in_secret_store
RETENTION_DAYS=30
RETENTION_BATCH_SIZE=5000
RETENTION_INTERVAL_MINUTES=1440
PUBLIC_BASE_URL=https://feedstream.example.com
GITHUB_REPO_URL=https://github.com/Archangel-77/feedstream
