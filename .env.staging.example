# Database
DATABASE_URL=postgresql+asyncpg://user:pass@staging-db-host:5432/feedstream_staging

# Redis
REDIS_URL=redis://staging-redis-host:6379/0

# AIS Stream
AIS_API_KEY=replace_in_secret_store

# App
APP_ENV=staging
LOG_LEVEL=INFO
ENABLE_DOCS=true
ENABLE_METRICS=true
DEBUG_STATS_TOKEN=replace_in_secret_store
RETENTION_DAYS=14
RETENTION_BATCH_SIZE=5000
RETENTION_INTERVAL_MINUTES=1440
PUBLIC_BASE_URL=https://staging.feedstream.example.com
GITHUB_REPO_URL=https://github.com/Archangel-77/feedstream
